/* ===== AI Native — Light ===== */
[data-theme="ai-native"][data-color-scheme="light"] {
  --theme-background: #eef6ff;
  --theme-foreground: #0f172a;
  --theme-card: #ffffff;
  --theme-card-foreground: #0f172a;
  --theme-primary: #2563ff;
  --theme-primary-foreground: #ffffff;
  --theme-secondary: #00b8d9;
  --theme-secondary-foreground: #06222d;
  --theme-accent: #ff5f7a;
  --theme-accent-foreground: #ffffff;
  --theme-destructive: #e11d48;
  --theme-muted: #dde8f7;
  --theme-muted-foreground: #4b5563;
  --theme-border: #1e293b;
  --theme-ring: #2563ff;
  --theme-surface: #f8fbff;
  --theme-radius: 12px;
  --theme-border-width: 2px;
  --theme-shadow-card: 0 10px 24px rgba(37, 99, 255, 0.18);
  --theme-shadow-card-hover: 0 14px 34px rgba(0, 184, 217, 0.24);
  --theme-grid: rgba(60, 120, 200, 0.15);
  --theme-robot-cyan: #0e7490;
  --theme-robot-purple: #6d28d9;
  --theme-robot-pink: #db2777;
  --theme-robot-green: #059669;
  --theme-robot-orange: #ea580c;
  --theme-robot-yellow: #ca8a04;
  color-scheme: light;
}

/* ===== AI Native — Dark ===== */
[data-theme="ai-native"][data-color-scheme="dark"] {
  --theme-background: #070b14;
  --theme-foreground: #e2ecff;
  --theme-card: #0f172a;
  --theme-card-foreground: #e2ecff;
  --theme-primary: #3b82f6;
  --theme-primary-foreground: #04060d;
  --theme-secondary: #22d3ee;
  --theme-secondary-foreground: #03171c;
  --theme-accent: #ff7ab8;
  --theme-accent-foreground: #18071a;
  --theme-destructive: #fb7185;
  --theme-muted: #111a2f;
  --theme-muted-foreground: #94a3b8;
  --theme-border: #93c5fd;
  --theme-ring: #22d3ee;
  --theme-surface: #0a1224;
  --theme-radius: 12px;
  --theme-border-width: 2px;
  --theme-shadow-card: 0 12px 30px rgba(59, 130, 246, 0.32);
  --theme-shadow-card-hover: 0 18px 40px rgba(34, 211, 238, 0.34);
  --theme-grid: rgba(82, 150, 255, 0.06);
  --theme-robot-cyan: #22d3ee;
  --theme-robot-purple: #a78bfa;
  --theme-robot-pink: #f472b6;
  --theme-robot-green: #34d399;
  --theme-robot-orange: #fb923c;
  --theme-robot-yellow: #facc15;
  color-scheme: dark;
}
